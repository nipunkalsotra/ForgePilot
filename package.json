{
  "name": "forgepilot",
  "displayName": "ForgePilot",
  "description": "TrueForge coding agent with secure inline and autonomous multi-file review, context retrieval and undo.",
  "version": "0.1.0",
  "type": "module",
  "publisher": "nipunkalsotra",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nipunkalsotra/ForgePilot.git"
  },
  "engines": {
    "vscode": "^1.101.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "forgepilot.start",
        "title": "ForgePilot: Start Read-Only Session"
      },
      {
        "command": "forgepilot.ask",
        "title": "ForgePilot: Ask Agent"
      },
      {
        "command": "forgepilot.cancel",
        "title": "ForgePilot: Cancel Turn"
      },
      {
        "command": "forgepilot.stop",
        "title": "ForgePilot: Stop Session and MCP Server"
      },
      {
        "command": "forgepilot.setToken",
        "title": "ForgePilot: Set TrueForge Authentication Token"
      },
      {
        "command": "forgepilot.inlineEdit",
        "title": "ForgePilot: Edit Selection"
      },
      {
        "command": "forgepilot.review",
        "title": "ForgePilot: Review Patch Hunks"
      },
      {
        "command": "forgepilot.showHunk",
        "title": "ForgePilot: Show Hunk Diff"
      },
      {
        "command": "forgepilot.acceptHunk",
        "title": "ForgePilot: Accept Hunk",
        "icon": "$(check)"
      },
      {
        "command": "forgepilot.rejectHunk",
        "title": "ForgePilot: Reject Hunk",
        "icon": "$(close)"
      },
      {
        "command": "forgepilot.acceptAll",
        "title": "ForgePilot: Accept All Hunks"
      },
      {
        "command": "forgepilot.rejectAll",
        "title": "ForgePilot: Reject All Hunks"
      },
      {
        "command": "forgepilot.apply",
        "title": "ForgePilot: Apply Accepted Hunks"
      },
      {
        "command": "forgepilot.undo",
        "title": "ForgePilot: Undo Last Accepted Edit"
      },
      {
        "command": "forgepilot.autonomous",
        "title": "ForgePilot: Autonomous Agent"
      },
      {
        "command": "forgepilot.batchDiff",
        "title": "ForgePilot: Show Batch File Diff"
      },
      {
        "command": "forgepilot.batchReview",
        "title": "ForgePilot: Review Batch Hunks"
      },
      {
        "command": "forgepilot.batchAccept",
        "title": "ForgePilot: Accept Batch File or Hunk",
        "icon": "$(check)"
      },
      {
        "command": "forgepilot.batchReject",
        "title": "ForgePilot: Reject Batch File or Hunk",
        "icon": "$(close)"
      },
      {
        "command": "forgepilot.batchAcceptRemaining",
        "title": "ForgePilot: Accept Remaining Batch Hunks"
      },
      {
        "command": "forgepilot.batchRejectRemaining",
        "title": "ForgePilot: Reject Remaining Batch Hunks"
      },
      {
        "command": "forgepilot.batchApply",
        "title": "ForgePilot: Apply Accepted Batch Hunks"
      },
      {
        "command": "forgepilot.batchUndo",
        "title": "ForgePilot: Undo Last Accepted Batch"
      },
      {
        "command": "forgepilot.contextInspector",
        "title": "ForgePilot: Inspect Repository Context"
      },
      {
        "command": "forgepilot.verificationTerminal",
        "title": "ForgePilot: Open Verification Terminal"
      },
      {
        "command": "forgepilot.newSession",
        "title": "ForgePilot: New Agent Session"
      }
    ],
    "configuration": {
      "title": "ForgePilot",
      "properties": {
        "forgepilot.baseUrl": {
          "type": "string",
          "default": "http://localhost:8790",
          "scope": "machine",
          "description": "Local TrueForge URL. Only loopback HTTP URLs are accepted."
        },
        "forgepilot.agentName": {
          "type": "string",
          "default": "forge-coder",
          "scope": "machine",
          "description": "Existing saved read-only TrueForge agent."
        },
        "forgepilot.turnTimeoutSeconds": {
          "type": "number",
          "default": 180,
          "minimum": 10,
          "maximum": 600,
          "scope": "machine",
          "description": "Overall turn deadline, including streaming."
        },
        "forgepilot.contextBudget": {
          "type": "number",
          "default": 12000,
          "minimum": 2000,
          "maximum": 32000,
          "scope": "machine",
          "description": "Estimated context token budget (UTF-8 bytes/3), including retrieval metadata and an instruction/output reserve."
        },
        "forgepilot.autonomousToolIntervalMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 10000,
          "scope": "machine",
          "description": "Optional minimum interval between autonomous MCP tool responses, to reduce model request bursts on limited provider plans. Does not change provider settings or retry model calls."
        },
        "forgepilot.fallbackEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow at most one automatic transition to the explicitly configured saved fallback agent after provider failure. May incur that agent model's normal charges.",
          "scope": "machine"
        },
        "forgepilot.fallbackAgentName": {
          "type": "string",
          "default": "",
          "description": "Saved TrueForge agent authorized for fallback. Required when fallbackEnabled is true; no model is selected automatically.",
          "scope": "machine"
        },
        "forgepilot.commandTimeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 1,
          "maximum": 120,
          "scope": "machine",
          "description": "Maximum per-command runtime for individually approved agent verification commands. Requires Linux Bubblewrap; no unsandboxed fallback."
        },
        "forgepilot.tokenBudget": {
          "type": "object",
          "scope": "machine",
          "default": {
            "mode": "off"
          },
          "additionalProperties": false,
          "description": "Task resource policy. Conservative is recommended after configuration; off preserves existing behavior. Provider limits are local configuration, never account quota. Estimates are UTF-8 bytes/3; actual metrics arrive after a turn.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "off",
                "advisory",
                "conservative",
                "strict"
              ],
              "default": "off"
            },
            "taskTokens": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 10000000
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 10,
              "maximum": 500,
              "default": 100
            },
            "maxValidationFailures": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 4
            },
            "maxRepeatedSearches": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 3
            },
            "provider": {
              "type": "object",
              "required": [
                "model"
              ],
              "additionalProperties": false,
              "properties": {
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "contextWindow": {
                  "type": "integer",
                  "minimum": 2000,
                  "maximum": 2000000
                },
                "maxOutputTokens": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200000
                },
                "inputTokensPerMinute": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000000
                },
                "requestsPerMinute": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "safetyMargin": {
                  "type": "number",
                  "minimum": 0.05,
                  "maximum": 0.5,
                  "default": 0.2
                }
              }
            }
          }
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "forgepilot.reviewView",
          "name": "ForgePilot Patch Review"
        },
        {
          "id": "forgepilot.batchView",
          "name": "ForgePilot Agent Changes"
        }
      ],
      "forgepilot": [
        {
          "id": "forgepilot.agentView",
          "name": "Agent",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
      {
        "command": "forgepilot.inlineEdit",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "forgepilot.review",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "forgepilot.autonomous",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "forgepilot.acceptHunk",
          "when": "view == forgepilot.reviewView && viewItem == forgepilotHunk",
          "group": "inline"
        },
        {
          "command": "forgepilot.rejectHunk",
          "when": "view == forgepilot.reviewView && viewItem == forgepilotHunk",
          "group": "inline"
        },
        {
          "command": "forgepilot.batchAccept",
          "when": "view == forgepilot.batchView && (viewItem == forgepilotBatchHunk || viewItem == forgepilotBatchFile)",
          "group": "inline"
        },
        {
          "command": "forgepilot.batchReject",
          "when": "view == forgepilot.batchView && (viewItem == forgepilotBatchHunk || viewItem == forgepilotBatchFile)",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "forgepilot.review",
          "when": "view == forgepilot.reviewView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.acceptAll",
          "when": "view == forgepilot.reviewView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.rejectAll",
          "when": "view == forgepilot.reviewView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.apply",
          "when": "view == forgepilot.reviewView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.cancel",
          "when": "view == forgepilot.reviewView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.undo",
          "when": "view == forgepilot.reviewView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.batchReview",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.batchAcceptRemaining",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.batchRejectRemaining",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.batchApply",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.batchUndo",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.contextInspector",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        },
        {
          "command": "forgepilot.cancel",
          "when": "view == forgepilot.batchView",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgepilot",
          "title": "ForgePilot",
          "icon": "media/forgepilot.svg"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepackage:extension": "node --input-type=module -e \"import {mkdir} from 'node:fs/promises'; await mkdir('artifacts',{recursive:true})\"",
    "package:extension": "npx --yes @vscode/vsce@3.7.1 package --no-dependencies --githubBranch feat/phase-3-autonomous-agent --out artifacts/forgepilot.vsix",
    "lint": "eslint . --max-warnings 0",
    "setup:agent": "node --import tsx scripts/setup-agent.ts",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-timeout=15000 tests/*.test.ts",
    "test:unit": "node --import tsx --test --test-timeout=15000 tests/workspace.test.ts tests/events.test.ts tests/config.test.ts tests/patch.test.ts tests/completion.test.ts tests/context.test.ts tests/batch.test.ts tests/drafts.test.ts tests/failure.test.ts",
    "test:integration": "npm run build && node --import tsx --test --test-timeout=15000 tests/mcp.test.ts tests/bridge.test.ts tests/approval.test.ts tests/resilience.test.ts",
    "test:live": "npm run build && node --import tsx scripts/verify-live.ts",
    "test:extension": "npm run build && node --import tsx scripts/verify-extension.ts",
    "check": "npm run build && npm run lint && npm test",
    "vscode:prepublish": "npm run build",
    "test:editing:live": "npm run build && node --import tsx scripts/verify-editing-live.ts",
    "test:taskc": "npm run build && node --import tsx scripts/verify-taskc.ts",
    "benchmark:context": "node --import tsx scripts/benchmark-context.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.0",
    "eslint": "10.15.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
