# Example only. TrueForge does not need a provider key in the extension.
# Use the environment of the TrueForge process or your shell's dotenv loader.
# TrueForge 0.185.1 requires this exact-host exception to reach our local MCP endpoint.
OUTBOUND_URL_ALLOWED_HOSTS=["127.0.0.1"]
PORT=8790
# Set model provider credentials in TrueForge Settings -> Models.
# Optional CLI verification authentication when TrueForge OIDC is enabled:
# TRUEFORGE_TOKEN=<short-lived-ID-token>
