-@click.command("run", short_help="Run a development server.")
+@click.command("config", short_help="Show the config values of the application.")
+@with_appcontext
+def config_command() -> None:
+    """Show the config values of the application."""
+    config = dict(current_app.config)
+    mask = "***"
+    sensitive_keys = {"SECRET", "PASSWORD", "TOKEN", "KEY"}
+
+    def is_sensitive(key: str) -> bool:
+        key_upper = key.upper()
+        return any(s in key_upper for s in sensitive_keys)
+
+    for key in config:
+        if is_sensitive(key):
+            config[key] = mask
+
+    click.echo(json.dumps(config, indent=2, sort_keys=True, default=str))
+
